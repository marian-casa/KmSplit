# Copiar este archivo a .env y completar con tus propios valores.
# El .env real NUNCA se sube al repo (ver .gitignore).

DEBUG=True
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-random

# Debe coincidir con lo definido en docker-compose.yml
POSTGRES_DB=kmsplit
POSTGRES_USER=kmsplit_user
POSTGRES_PASSWORD=kmsplit_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
ADMIN_URL=cambiar-esto-por-una-ruta-propia/

# Correo para recuperación de contraseña.
# Si EMAIL_HOST_USER queda vacío, el mail se imprime en la consola del
# backend (útil en desarrollo sin un SMTP real).
DEFAULT_FROM_EMAIL=noreply@kmsplit.app
DEFAULT_FROM_NAME=KmSplit
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Timeout (segundos) de la conexión SMTP
EMAIL_TIMEOUT=10
#
# CAMINO RECOMENDADO PARA PRODUCCION (Brevo): el SMTP saliente (587/465)
# suele estar bloqueado en Railway. La API REST de Brevo viaja por HTTPS (443)
# y funciona siempre. Si BREVO_API_KEY está seteada, se usa API en vez de SMTP.
# Sacá tu API key en Brevo -> SMTP & API -> API Keys (empieza con 'xkeysib-').
# El remitente (DEFAULT_FROM_EMAIL) tiene que estar verificado en Brevo.
BREVO_API_KEY=
# Si en cambio preferís SMTP, usá: EMAIL_HOST=smtp-relay.brevo.com,
# EMAIL_HOST_USER=<SMTP login de Brevo>, EMAIL_HOST_PASSWORD=<SMTP key>.
# Puertos alternativos si 587 está bloqueado: 465 con EMAIL_USE_SSL=True.
# Duración del código de recuperación en minutos
PASSWORD_RESET_CODE_TTL_MINUTES=15